<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>Preview</LangVersion>
        <Nullable>enable</Nullable>
        <Description>CLR_ST_GEOG_* geography functions for Apache Calcite that read coordinates as WGS84 and answer geodesically, in metres, using Google's S2 and GeographicLib. Complements Calcite's planar ST_* functions.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>apache;calcite;sql;spatial;geography;geodesic;wgs84;s2;ikvm</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Apache.Calcite.Geography.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="IKVM" Version="8.16.1" />
        <PackageReference Include="IKVM.Java.Extensions" Version="8.16.1" />
        <!-- Not PrivateAssets: this package ships only buildTransitive assets, and marking it private stops
             them reaching consumers, which then fail at run time loading 'calcite.core'. -->
        <PackageReference Include="IKVM.Maven.Sdk" Version="1.12.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- These versions match every other project in the repository: calcite-core and calcite-linq4j must
             come from the same build, and IKVM bakes the resolved versions into the compiled assemblies. -->
        <MavenReference Include="org.apache.commons:commons-lang3" Version="3.18.0" />
        <MavenReference Include="org.slf4j:slf4j-api" Version="2.0.17" />
        <MavenReference Include="org.apache.calcite:calcite-core" Version="1.43.0-SNAPSHOT">
            <Dependencies>
                com.jayway.jsonpath:json-path/com.fasterxml.jackson.core:jackson-databind:2.22.2,optional=true;
                com.jayway.jsonpath:json-path/com.fasterxml.jackson.core:jackson-core:2.22.2,optional=true
            </Dependencies>
        </MavenReference>
        <!-- S2 answers the topological questions: containment, intersection, touching, closest points. It
             models a sphere, which is accurate enough for deciding which side of an edge a point lies on. -->
        <MavenReference Include="com.google.geometry:s2-geometry" Version="2.0.0" />
        <!-- GeographicLib answers the measurements (distance, length, area) on the WGS84 ellipsoid; a spherical
             answer can differ from a WGS84 store's by about half a percent. -->
        <MavenReference Include="net.sf.geographiclib:GeographicLib-Java" Version="2.0" />
    </ItemGroup>

</Project>
