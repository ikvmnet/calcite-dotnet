<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <!-- xunit.v3 test projects are executables running on Microsoft.Testing.Platform. -->
        <OutputType>Exe</OutputType>
        <!-- xUnit1051 asks every call to pass the test framework's CancellationToken. These tests pass
             the tokens they are testing. -->
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="IKVM" Version="8.16.1" />
        <PackageReference Include="IKVM.Java.Extensions" Version="8.16.1" />
        <!-- Not PrivateAssets: this package ships only buildTransitive assets, and marking it private stops
             them reaching consumers, which then fail at run time loading 'calcite.core'. -->
        <PackageReference Include="IKVM.Maven.Sdk" Version="1.12.1" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageReference Include="coverlet.collector" Version="10.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="4.0.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <MavenReference Include="org.apache.commons:commons-lang3" Version="3.18.0" />
        <MavenReference Include="org.slf4j:slf4j-api" Version="2.0.17" />
        <MavenReference Include="org.apache.calcite:calcite-core" Version="1.43.0-SNAPSHOT">
            <Dependencies>
                com.jayway.jsonpath:json-path/com.fasterxml.jackson.core:jackson-databind:2.22.2,optional=true;
                com.jayway.jsonpath:json-path/com.fasterxml.jackson.core:jackson-core:2.22.2,optional=true
            </Dependencies>
        </MavenReference>
        <MavenReference Include="org.apache.calcite:calcite-server" Version="1.43.0-SNAPSHOT" />
    </ItemGroup>

    <ItemGroup>
        <!-- The recorded result of every reader accessor against every Calcite type, compared by
             CalciteReaderMatrixTests. -->
        <EmbeddedResource Include="ReaderMatrix.txt" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Apache.Calcite.Data\Apache.Calcite.Data.csproj" />
        <ProjectReference Include="..\Apache.Calcite.Extensions\Apache.Calcite.Extensions.csproj" />
    </ItemGroup>

</Project>
