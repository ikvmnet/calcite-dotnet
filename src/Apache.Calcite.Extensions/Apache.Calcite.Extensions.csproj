<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>Preview</LangVersion>
        <Nullable>enable</Nullable>
        <Description>The .NET query engine for Apache Calcite: a calling convention that compiles query plans to System.Linq.Expressions instead of generated Java, the pipeline that prepares a statement for it, and typed Calcite connection properties. .NET methods can be called from SQL as user-defined functions.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>apache;calcite;sql;query;linq;expressions;ikvm</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Apache.Calcite.Data" />
        <InternalsVisibleTo Include="Apache.Calcite.Data.Common" />
        <InternalsVisibleTo Include="Apache.Calcite.Adapter.AdoNet" />
        <InternalsVisibleTo Include="Apache.Calcite.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="IKVM" Version="8.16.1" />
        <PackageReference Include="IKVM.Java.Extensions" Version="8.16.1" />
        <PackageReference Include="IKVM.Jdbc.Data" Version="1.0.13" />
        <!-- Not PrivateAssets: this package ships only buildTransitive assets, and marking it private stops
             them reaching consumers, which then fail at run time loading 'calcite.core'. -->
        <PackageReference Include="IKVM.Maven.Sdk" Version="1.12.1" />
        <!-- calcite-linq4j is not referenced directly, so it always resolves to the version calcite-core
             brings. The two must come from the same build. -->
        <MavenReference Include="org.apache.commons:commons-lang3" Version="3.18.0" />
        <MavenReference Include="org.slf4j:slf4j-api" Version="2.0.17" />
        <MavenReference Include="org.apache.calcite:calcite-core" Version="1.43.0-SNAPSHOT">
            <Dependencies>
                com.jayway.jsonpath:json-path/com.fasterxml.jackson.core:jackson-databind:2.22.2,optional=true;
                com.jayway.jsonpath:json-path/com.fasterxml.jackson.core:jackson-core:2.22.2,optional=true
            </Dependencies>
        </MavenReference>
        <MavenReference Include="org.jooq:joou-java-6" Version="0.9.5" />
    </ItemGroup>

</Project>
