<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <!-- an xunit.v3 test project is a program: the package writes the entry point and the assembly runs
             itself on Microsoft.Testing.Platform -->
        <OutputType>Exe</OutputType>
        <!-- xUnit1051 wants every call taking a CancellationToken to take the framework's, so that a hung
             test can be cancelled. These suites pass the tokens they mean to, and several exist to assert
             what happens to one, so adopting it is a change to make on its own terms. -->
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
        <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    </PropertyGroup>

    <ItemGroup>
        <!-- CI runs `dotnet test <dll>`, which is vstest.console, so the VSTest bridge has to be in the
             output beside the platform the assembly runs itself on. xunit.runner.visualstudio carries the
             adapter and Microsoft.NET.Test.Sdk the testhost. -->
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageReference Include="xunit.v3" Version="4.0.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="IKVM" Version="8.16.1" />
        <PackageReference Include="IKVM.Java.Extensions" Version="8.16.1" />
        <PackageReference Include="IKVM.Jdbc.Data" Version="1.0.13" />
        <!-- Not PrivateAssets, deliberately. This package ships only buildTransitive, which is the folder that
             carries build assets to consumers; marking it private disables the one mechanism it has, and a project
             that references ours then compiles and fails at run time with `Could not load file or assembly
             'calcite.core'`. The default PrivateAssets keeps `build` to ourselves and lets buildTransitive through. -->
        <PackageReference Include="IKVM.Maven.Sdk" Version="1.12.1" />
        <PackageReference Include="FluentAssertions" Version="8.10.0" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
        <PackageReference Include="System.Data.Odbc" Version="10.0.11" />
        <PackageReference Include="System.Data.OleDb" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Apache.Calcite.Adapter.AdoNet\Apache.Calcite.Adapter.AdoNet.csproj" />
        <ProjectReference Include="..\Apache.Calcite.Data\Apache.Calcite.Data.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="csv\people.csv">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
