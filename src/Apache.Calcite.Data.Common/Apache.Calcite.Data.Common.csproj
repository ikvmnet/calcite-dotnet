<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0</TargetFrameworks>
        <Description>The mapping between Apache Calcite SQL types and .NET types used by Apache.Calcite.Data and Apache.Calcite.Adapter.AdoNet: which .NET type each SQL type is read as, and the conversions in both directions. Extensible with custom type resolvers.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>apache;calcite;ado.net;sql;types;ikvm</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Apache.Calcite.Data" />
        <InternalsVisibleTo Include="Apache.Calcite.Adapter.AdoNet" />
        <InternalsVisibleTo Include="Apache.Calcite.Data.Common.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Apache.Calcite.Extensions\Apache.Calcite.Extensions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="IKVM" Version="8.16.1" />
        <PackageReference Include="IKVM.Java.Extensions" Version="8.16.1" />
        <!-- Not PrivateAssets: this package ships only buildTransitive assets, and marking it private stops
             them reaching consumers, which then fail at run time loading 'calcite.core'. -->
        <PackageReference Include="IKVM.Maven.Sdk" Version="1.12.1" />
        <MavenReference Include="org.apache.commons:commons-lang3" Version="3.18.0" />
        <MavenReference Include="org.slf4j:slf4j-api" Version="2.0.17" />
        <MavenReference Include="org.apache.calcite:calcite-core" Version="1.43.0-SNAPSHOT">
            <Dependencies>
                com.jayway.jsonpath:json-path/com.fasterxml.jackson.core:jackson-databind:2.22.2,optional=true;
                com.jayway.jsonpath:json-path/com.fasterxml.jackson.core:jackson-core:2.22.2,optional=true
            </Dependencies>
        </MavenReference>
        <MavenReference Include="org.jooq:joou-java-6" Version="0.9.5" />
    </ItemGroup>

</Project>
