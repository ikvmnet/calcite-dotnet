<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>Preview</LangVersion>
        <Nullable>enable</Nullable>
        <Description>CLR_FT_* full-text search functions for Apache Calcite: predicates, relevance score, rank fusion, and phrase, prefix and fuzzy term constructors. Declares names, arities and types for adapters to push down to a store's full-text engine; it does not evaluate them itself.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>apache;calcite;sql;full-text;search;fulltext;ikvm</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Apache.Calcite.FullText.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="IKVM" Version="8.16.1" />
        <PackageReference Include="IKVM.Java.Extensions" Version="8.16.1" />
        <!-- Not PrivateAssets: this package ships only buildTransitive assets, and marking it private stops
             them reaching consumers, which then fail at run time loading 'calcite.core'. -->
        <PackageReference Include="IKVM.Maven.Sdk" Version="1.12.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- These versions match every other project in the repository: calcite-core and calcite-linq4j must
             come from the same build, and IKVM bakes the resolved versions into the compiled assemblies.
             json-path's POM omits its jackson dependency (json-path/JsonPath#1082), so it is declared here,
             optional as json-path intends. -->
        <MavenReference Include="org.apache.commons:commons-lang3" Version="3.18.0" />
        <MavenReference Include="org.slf4j:slf4j-api" Version="2.0.17" />
        <MavenReference Include="org.apache.calcite:calcite-core" Version="1.43.0-SNAPSHOT">
            <Dependencies>
                com.jayway.jsonpath:json-path/com.fasterxml.jackson.core:jackson-databind:2.22.2,optional=true;
                com.jayway.jsonpath:json-path/com.fasterxml.jackson.core:jackson-core:2.22.2,optional=true
            </Dependencies>
        </MavenReference>
    </ItemGroup>

</Project>
