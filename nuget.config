<?xml version="1.0" encoding="utf-8"?>
<configuration>

    <!-- The ikvmnet GitHub Packages feed carries IKVM packages that nuget.org does not.

         GitHub Packages requires authentication even to read, and NuGet does not expand environment
         variables in packageSourceCredentials, so credentials cannot live in this file. Add them once
         per machine, to your user-level NuGet.Config, with `dotnet nuget update source ikvmnet`: your
         GitHub user name, a token with read:packages as the password, and the option that stores it in
         clear text (the encrypted store is Windows-only). CI does the same with its own token. -->
    <packageSources>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="ikvmnet" value="https://nuget.pkg.github.com/ikvmnet/index.json" protocolVersion="3" />
    </packageSources>

</configuration>
